<%= form_with model: pickup_game, class: "vstack gap-4" do |form| %>
  <% if pickup_game.errors.any? %>
    <div class="alert alert-danger app-card">
      <strong>Revise os campos abaixo.</strong>
      <ul class="mb-0">
        <% pickup_game.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="app-card p-4">
    <div class="row g-3">
      <div class="col-12 col-lg-4">
        <%= form.label :start_at, "Data e hora", class: "form-label" %>
        <%= form.datetime_local_field :start_at, class: "form-control", step: 1800 %>
      </div>

      <div class="col-12 col-lg-3">
        <%= form.label :duration, "Duração (horas)", class: "form-label" %>
        <%= form.number_field :duration, class: "form-control", min: 1, step: 1 %>
      </div>
    </div>
  </div>

  <div class="app-card p-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
      <h2 class="h5 mb-0">Participantes</h2>
      <span class="text-body-secondary">Selecione atletas cadastrados</span>
    </div>

    <ul class="nav nav-pills mb-3" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#pickup-regular" type="button" role="tab">Regulares</button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="pill" data-bs-target="#pickup-guests" type="button" role="tab">Convidados</button>
      </li>
    </ul>

    <div class="tab-content">
      <div class="tab-pane fade show active" id="pickup-regular" role="tabpanel">
        <%= render "pickup_games/athlete_checklist", form: form, athletes: regular_athletes, empty_message: "Nenhum atleta regular cadastrado ainda." %>
      </div>
      <div class="tab-pane fade" id="pickup-guests" role="tabpanel">
        <%= render "pickup_games/athlete_checklist", form: form, athletes: guest_athletes, empty_message: "Nenhum convidado cadastrado ainda." %>
      </div>
    </div>
  </div>

  <div class="d-flex gap-2">
    <%= form.submit "Salvar pelada", class: "btn btn-primary" %>
    <%= link_to "Cancelar", pickup_games_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
