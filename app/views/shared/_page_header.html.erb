<section class="page-hero p-4 p-lg-5 mb-4">
  <div class="page-hero__grid">
    <div class="page-hero__copy">
      <% if local_assigns[:eyebrow].present? %>
        <div class="page-hero__eyebrow"><%= eyebrow %></div>
      <% end %>
      <h1 class="page-hero__title"><%= title %></h1>
      <% if local_assigns[:subtitle].present? %>
        <p class="page-hero__subtitle"><%= subtitle %></p>
      <% end %>

      <% if local_assigns[:actions].present? %>
        <div class="page-hero__actions">
          <%= actions %>
        </div>
      <% end %>
    </div>

    <% if local_assigns[:stats].present? %>
      <aside class="page-hero__panel">
        <% stats.each do |stat| %>
          <div class="page-hero__stat">
            <span class="page-hero__stat-label"><%= stat[:label] %></span>
            <strong class="page-hero__stat-value"><%= stat[:value] %></strong>
          </div>
        <% end %>
      </aside>
    <% end %>
  </div>
</section>
